# Copy this template to .env; models/server.py loads it automatically.
# Process environment variables take precedence. Never put an API key in React.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=none
# For Claude, set LLM_PROVIDER=anthropic and configure this key/model instead.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Optional overrides; defaults allow the local React development servers.
# FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3100
# BIASANALYZER_HOST=127.0.0.1
